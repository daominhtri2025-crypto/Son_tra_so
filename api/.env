# Cấu hình máy chủ Sơn Trà Số. Sao chép thành tệp .env (hoặc đặt ở nơi an toàn ngoài public_html
# và khai báo SetEnv SONTRA_ENV_FILE trong .htaccess). KHÔNG commit tệp .env thật.

APP_URL=https://cds-sontra.io.vn
GOOGLE_CLIENT_ID=286984819794-pfp1t6urmvb29ekgti4k91o15em1tj0c.apps.googleusercontent.com

APP_DEBUG=false

# Cơ sở dữ liệu MySQL (lấy trong hPanel/cPanel → Databases)
DB_HOST=localhost
# 3306 = MySQL/MariaDB (XAMPP, MySQL Server). KHÔNG dùng SQL Server (cổng 1433): ứng dụng không chạy trên SQL Server.
DB_PORT=3306
DB_NAME=qiogdglehosting_sontra
DB_USER=qiogdglehosting_sontra
DB_PASS=Minhtri2026@
DB_CHARSET=utf8mb4

# Đăng nhập Google (OAuth Client ID loại "Web application"; Authorized JavaScript origin = APP_URL)
GOOGLE_CLIENT_ID=

# Đồng bộ tin tức tự động: để false trừ khi có văn bản cho phép truy cập tự động (MASTER_SPEC mục 12.6)
NEWS_SYNC_ENABLED=false
NEWS_FEED_URL=

# Thư mục lưu tệp media (mặc định: <thư mục web>/uploads/media)
MEDIA_PUBLIC_PREFIX=/uploads/media

# Gửi thư khôi phục mật khẩu.
# MAIL_DRIVER: smtp (mặc định nếu có SMTP_HOST) hoặc mail (hàm mail() của PHP; nhiều hosting không dùng được).
MAIL_DRIVER=
MAIL_FROM=no-reply@your-domain.example
MAIL_FROM_NAME=Sơn Trà Số
# Máy chủ SMTP (nhà cung cấp hosting hoặc dịch vụ gửi thư giao dịch cung cấp):
SMTP_HOST=
SMTP_PORT=587
# tls = STARTTLS (cổng 587, thường dùng); ssl = SMTPS (cổng 465); none = không mã hóa (chỉ mạng nội bộ)
SMTP_ENCRYPTION=tls
SMTP_USER=
SMTP_PASS=

# Kiểm tra mật khẩu bị rò rỉ (API Pwned Passwords, chỉ gửi 5 ký tự đầu của băm SHA-1)
PWNED_CHECK_ENABLED=true
# true: không kiểm tra được thì vẫn cho qua (và ghi nhật ký). false: từ chối an toàn.
PWNED_CHECK_FAIL_OPEN=true
