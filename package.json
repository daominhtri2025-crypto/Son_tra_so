  "version": "1.0.0",
  "type": "module",
  "description": "Nền tảng chuyển đổi số và nâng cao năng lực số cho người dân quận Sơn Trà, Đà Nẵng.",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
